# ==========================================
# CẤU HÌNH API KEYS VÀ SERVER ENVIRONMENT
# ==========================================

# Port chạy server Express (Mặc định: 3000)
PORT=3000

# Base URL cho các API chuẩn OpenAI (DeepSeek, MiniMax, v.v.)
AI_BASE_URL=https://api.deepseek.com

# Danh sách DeepSeek Pro API Keys (Phân cách bằng dấu phẩy)
DEEPSEEK_API_KEYS=sk-key1,sk-key2,sk-key3
DEEPSEEK_API_KEY=sk-key1

# Danh sách DeepSeek Flash API Keys (Phân cách bằng dấu phẩy)
FLASH_API_KEYS=sk-key1,sk-key2,sk-key3
FLASH_API_KEY=sk-key1

# Danh sách MiniMax M3 API Keys (Phân cách bằng dấu phẩy)
MINIMAX_API_KEYS=sk-minimax1,sk-minimax2,sk-minimax3
MINIMAX_API_KEY=sk-minimax1

# OpenRouter Nemotron API Key & Base URL
OPENROUTER_API_KEY=sk-or-v1-key...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ==========================================
# CẤU HÌNH BẢO MẬT & XÁC THỰC (TÙY CHỌN)
# ==========================================

# Khóa API Token xác thực truy cập (Để trống nếu chạy localhost tự do)
# Nếu cài đặt, client phải truyền header `x-api-token: YOUR_SECRET_TOKEN` hoặc query `?token=YOUR_SECRET_TOKEN`
API_TOKEN=

# Danh sách Domain được phép gọi API (CORS) - Phân cách bằng dấu phẩy
# Ví dụ: ALLOWED_ORIGINS=http://localhost:3000,https://mydomain.com
ALLOWED_ORIGINS=
